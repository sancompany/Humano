# SAN & CO. — backend/.env.example
#
# Copie este arquivo para ".env" (sem o ".example") e preencha com a sua
# chave de verdade. O ".env" nunca deve ser commitado — o .gitignore já
# está configurado para ignorá-lo, mas confira antes do primeiro "git add".

# Chave da API da Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Opcional — só mude se o modelo padrão (gemini-2.0-flash) não existir
# mais quando você for rodar isto. Confira em:
# https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.0-flash

# Porta em que o backend sobe
PORT=3000

# Origem liberada no CORS — o endereço do Live Server do frontend
ORIGEM_FRONTEND=http://127.0.0.1:5500

# ---------------------------------------------------------------------
# GOOGLE (Drive, Gmail, Agenda) — passo a passo:
#
#   1. Acesse https://console.cloud.google.com/ e crie um projeto novo
#      (ou use um que já tenha).
#   2. Menu "APIs e serviços" > "Biblioteca" — ative estas 3 APIs:
#        Google Drive API
#        Gmail API
#        Google Calendar API
#   3. Menu "APIs e serviços" > "Tela de consentimento OAuth":
#        Tipo de usuário: "Externo" (a menos que você tenha Google
#        Workspace, aí pode ser "Interno")
#        Preencha nome do app, e-mail de suporte — o resto pode ficar
#        em branco por enquanto
#        Em "Usuários de teste", adicione o e-mail da conta Google que
#        vai autorizar o SAN & CO. (enquanto o app não passa por revisão
#        do Google, só e-mails cadastrados aqui conseguem autorizar)
#   4. Menu "APIs e serviços" > "Credenciais" > "+ Criar credenciais" >
#      "ID do cliente OAuth":
#        Tipo de aplicativo: "Aplicativo da Web"
#        Em "URIs de redirecionamento autorizados", adicione EXATAMENTE:
#          http://localhost:8085/oauth2callback
#        (essa porta é só do script de autorização — backend/scripts/
#        autorizar-google.js — não é a porta 3000 do servidor principal)
#   5. O Google mostra o Client ID e o Client Secret — cole os dois
#      abaixo.
#   6. Rode `npm run autorizar-google` (na pasta backend/) e siga as
#      instruções que aparecem no terminal. No final, ele imprime o
#      GOOGLE_REFRESH_TOKEN — cole na linha correspondente abaixo.
# ---------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8085/oauth2callback

# Preenchido pelo script autorizar-google — não escreva isto à mão
GOOGLE_REFRESH_TOKEN=

# ---------------------------------------------------------------------
# SUPABASE — pegue os dois valores em Configurações > API do projeto:
#   SUPABASE_URL: a "Project URL" no topo da página
#   SUPABASE_SERVICE_KEY: a chave "service_role" (secret) — NÃO a "anon"
#   A service_role ignora RLS e tem acesso total; é a certa pro backend,
#   nunca deve ir pro frontend nem ser exposta em nenhum lugar público.
# ---------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
